---
import Projects from "../components/home/projects.astro";
import Separator from "../components/home/separator.astro";
import Writings from "../components/home/writings.astro";
import Layout from "../layouts/main.astro";
---

<Layout fullTitle="姜小小的博客 - 做一个有意思的人">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-4 px-7 md:mt-8 lg:mt-12 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <h1
          class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
        >
          Hello, I'm Jiang.
        </h1>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          Some things are etched in the heart and never fade; others quietly dissolve with time.
        </p>
        <p class="mb-2 text-base text-neutral-600 dark:text-neutral-400">
          I write down whatever I can still remember, leaving a trace that I was here.
        </p>
        <ul class="mb-6 list-disc pl-5 text-base text-neutral-600 dark:text-neutral-400 space-y-1">
          <li>Writing &amp; Essays</li>
          <li>Blogs &amp; Little Tools</li>
          <li>Programming &amp; Automation</li>
          <li>City Memories</li>
          <li>Things I Tinker With</li>
        </ul>
        <a
          href="https://m.134688.xyz"
          class="inline-flex w-auto px-4 py-2 text-xs font-semibold duration-300 ease-out border rounded-full bg-neutral-900 dark:bg-white dark:text-neutral-900 text-neutral-100 hover:border-neutral-700 border-neutral-900 dark:hover:border-neutral-300 hover:bg-white dark:hover:bg-black dark:hover:text-white hover:text-neutral-900"
        >
          Drop by Jiang's Little World
        </a>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute bottom-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 lg:top-auto top-0 lg:-translate-y-[330px] rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
                >👋</span
              >
            </span>
          </div>
          <div class="relative z-30 px-10">
            <button
              id="hero-avatar"
              type="button"
              aria-label="播放 姜小小的博客 标志动画"
              class="group relative z-30 block w-full cursor-pointer rounded-2xl outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 dark:focus-visible:ring-neutral-600"
            >
              <svg
                id="hero-avatar-img"
                viewBox="0 0 200 210"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="relative z-30 w-full max-w-[280px] md:max-w-md mx-auto text-neutral-900 dark:text-neutral-100 transition duration-300 group-hover:scale-[1.03] animate-spin"
                style="animation-duration:5s"
                aria-label="旋转的机器人"
              >
                <!-- 天线 -->
                <line x1="100" y1="28" x2="100" y2="48" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
                <circle cx="100" cy="20" r="9" fill="currentColor" />
                <!-- 头 -->
                <rect x="50" y="48" width="100" height="74" rx="22" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="6" />
                <!-- 眼睛 -->
                <circle cx="80" cy="84" r="10" fill="currentColor" />
                <circle cx="120" cy="84" r="10" fill="currentColor" />
                <!-- 嘴 -->
                <rect x="80" y="104" width="40" height="7" rx="3.5" fill="currentColor" />
                <!-- 脖子 -->
                <rect x="92" y="122" width="16" height="10" fill="currentColor" />
                <!-- 身体 -->
                <rect x="62" y="132" width="76" height="54" rx="18" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="6" />
                <!-- 身体装饰灯 -->
                <circle cx="100" cy="159" r="7" fill="currentColor" />
                <!-- 手臂 -->
                <rect x="38" y="140" width="20" height="40" rx="10" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="6" />
                <rect x="142" y="140" width="20" height="40" rx="10" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="6" />
                <!-- 轮子 -->
                <circle cx="82" cy="196" r="13" fill="currentColor" />
                <circle cx="118" cy="196" r="13" fill="currentColor" />
              </svg>
            </button>
          </div>
          <video
            id="hero-logo-video"
            data-src="/assets/video/jreely-logo.mp4"
            class="absolute top-1/2 left-1/2 z-40 w-full max-w-md -translate-x-1/2 -translate-y-1/2 object-contain opacity-0 transition-opacity duration-300 pointer-events-none mix-blend-multiply [filter:contrast(1.5)] [mask-image:linear-gradient(to_right,transparent,black_2%,black_98%,transparent)] dark:mix-blend-screen dark:[filter:invert(1)_hue-rotate(180deg)_contrast(1.5)]"
            playsinline
            preload="none"
            aria-hidden="true"
          ></video>
          <div
            class="absolute bottom-0 right-0 z-20 w-full h-full lg:h-[420px] translate-x-0 -translate-y-px rounded-2xl bg-white dark:bg-neutral-950"
          >
          </div>
        </div>
      </div>
    </div>
  </div>

  <Separator text="折腾的一些小项目" />
  <Projects />
  <Separator text="突然的一些小想法" />
  <Writings />

  <script is:inline>
    (() => {
      const trigger = document.getElementById("hero-avatar");
      const img = document.getElementById("hero-avatar-img");
      const video = document.getElementById("hero-logo-video");
      if (!trigger || !img || !video) return;

      trigger.addEventListener("click", () => {
        if (!video.paused) return;
        if (!video.getAttribute("src")) {
          video.src = video.dataset.src;
          video.load();
        }
        video.play().catch(() => {});
      });

      video.addEventListener("playing", () => {
        video.classList.remove("opacity-0");
        img.classList.add("opacity-0");
      });

      video.addEventListener("ended", () => {
        video.pause();
        video.classList.add("opacity-0");
        img.classList.remove("opacity-0");
      });
    })();
  </script>
</Layout>
