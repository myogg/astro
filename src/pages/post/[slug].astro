---
import { getCollection } from "astro:content";
import WalineComments from "../../components/waline-comments.astro";
import PostLayout from "../../layouts/post.astro";
import { byDateDesc } from "../../utils/date";

export async function getStaticPaths() {
	const postEntries = await getCollection("post", ({ data }) => !data.draft);
	const sorted = postEntries.sort(byDateDesc);

	return sorted.map((entry, index) => ({
		params: { slug: entry.slug },
		props: {
			entry,
			prev: index > 0 ? sorted[index - 1] : null,
			next: index < sorted.length - 1 ? sorted[index + 1] : null,
		},
	}));
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const tags = entry.data.tags || [];
// 分享封面优先级：Frontmatter image > 正文第一张图片 > 全站默认封面
const markdownImage = entry.body.match(/!\[[^\]]*\]\((?:<)?([^) >]+)(?:>)?(?:\s+[^)]*)?\)/)?.[1];
const htmlImage = entry.body.match(/<img\b[^>]*\bsrc=["']([^"']+)["']/i)?.[1];
const shareImage = entry.data.image || markdownImage || htmlImage;
---

<PostLayout frontmatter={entry.data} shareImage={shareImage}>
  <Content />
  {tags.length > 0 && (
    <div class="not-prose flex flex-wrap gap-2 mt-6 mb-4">
      {tags.map((tag: string) => (
        <a
          href={`/tags/${tag}`}
          class="text-xs px-3 py-1 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-full text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:border-neutral-500 dark:hover:border-neutral-400 transition-colors"
        >
          {tag}
        </a>
      ))}
    </div>
  )}
  <WalineComments slot="comments" />
  <nav slot="nav" class="flex items-center justify-between gap-4 pt-8 border-t border-neutral-200 dark:border-neutral-800">
    {prev ? (
      <a
        href={`/post/${prev.slug}`}
        class="group flex-1 min-w-0 p-4 rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors"
      >
        <span class="block text-xs text-neutral-400 dark:text-neutral-500 mb-1">上一篇</span>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 truncate group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors">
          {prev.data.title}
        </span>
      </a>
    ) : <div class="flex-1" />}
    {next ? (
      <a
        href={`/post/${next.slug}`}
        class="group flex-1 min-w-0 p-4 rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors text-right"
      >
        <span class="block text-xs text-neutral-400 dark:text-neutral-500 mb-1">下一篇</span>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 truncate group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors">
          {next.data.title}
        </span>
      </a>
    ) : <div class="flex-1" />}
  </nav>
</PostLayout>
