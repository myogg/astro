---
import Layout from "../layouts/main.astro";
import PageHeading from "../components/page-heading.astro";
import galleryData from "../data/gallery.json";

type Photo = { url: string; thumb?: string; caption?: string; date?: string };
type Group = { name: string; slug?: string; date?: string; photos: Photo[] };
type GalleryData = { title: string; description: string; groups: Group[] };

const data = galleryData as GalleryData;
const groups = (data.groups || []).map((g) => ({
  name: g.name,
  slug: g.slug || "",
  date: g.date || "",
  cover: g.photos?.[0]?.thumb || g.photos?.[0]?.url || "",
  count: (g.photos || []).length,
}));
const total = groups.reduce((n, g) => n + g.count, 0);
const description = total > 0 ? `${data.description}（${groups.length} 组 · 共 ${total} 张）` : data.description;

function groupUrl(g: (typeof groups)[number]) {
  if (g.slug) return `/gallery/${g.slug}/`;
  return `/gallery/?group=${encodeURIComponent(g.name)}`;
}
---

<Layout title="画廊" description={description}>
  <section class="relative z-20 max-w-5xl mx-auto my-12 px-7 lg:px-0">
    <div class="pb-6 border-b border-dashed border-neutral-300 dark:border-neutral-700">
      <PageHeading title={data.title || "画廊"} description={description} />
    </div>

    {
      groups.length === 0 ? (
        <p class="mt-10 text-sm text-neutral-500 dark:text-neutral-400">相册还在整理，很快就好。</p>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 mt-10">
          {
            groups.map((g) => (
              <a
                href={groupUrl(g)}
                class="group relative block overflow-hidden rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-neutral-300 dark:hover:border-neutral-600"
              >
                <div class="aspect-[4/3] overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                  {
                    g.cover ? (
                      <img
                        src={g.cover}
                        alt={g.name}
                        loading="lazy"
                        class="block h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center text-xs text-neutral-400">暂无封面</div>
                    )
                  }
                </div>
                <div class="flex items-baseline justify-between gap-3 p-4">
                  <h2 class="text-base font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
                    {g.name}
                  </h2>
                  <div class="flex shrink-0 items-center gap-2 text-xs tabular-nums text-neutral-400 dark:text-neutral-500">
                    {g.date && <span>{g.date}</span>}
                    <span>{g.count} 张</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      )
    }
  </section>
</Layout>
