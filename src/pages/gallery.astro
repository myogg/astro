---
import gallery from "../data/gallery.json";
import MainLayout from "../layouts/main.astro";
const title = "GALLERY";
---

<MainLayout title={title}>
  <main class="gallery-page">
    <header class="gallery-head">
      <h1>GALLERY</h1>
      <p class="sub">A CURATED COLLECTION OF STREET PHOTOGRAPHY — {gallery.length} PHOTOS</p>
      <div class="rule"></div>
      <nav class="filters" id="filters">
        <button type="button" data-filter="all" class="active">全部 ALL</button>
        <button type="button" data-filter="street">街头 STREET</button>
        <button type="button" data-filter="life">生活 LIFE</button>
        <button type="button" data-filter="food">食物 FOOD</button>
        <button type="button" data-filter="river">江边 RIVER</button>
      </nav>
    </header>

    <section class="gallery" id="gallery">
      {gallery.map((img, i) => (
        <figure class="item" data-tags={img.tags.join(" ")} data-index={i}>
          <button class="thumb-btn" data-index={i} aria-label={img.title}>
            <div class="img-wrap" style={`aspect-ratio: ${img.width} / ${img.height}`}>
              <img src={img.thumb} data-full={img.url} alt={img.title} width={img.width} height={img.height} loading={i < 3 ? "eager" : "lazy"} decoding="async" />
            </div>
            <figcaption>
              <span class="cn">{img.title}</span>
              <span class="en">{img.en ? img.en + " — " : ""}{img.date}</span>
            </figcaption>
          </button>
        </figure>
      ))}
    </section>
    <p class="rotate-hint">↻ 旋转手机，横图体验更佳</p>
  </main>

  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button class="lb-close" id="lbClose" aria-label="关闭">×</button>
    <button class="lb-prev" id="lbPrev" aria-label="上一张">‹</button>
    <button class="lb-next" id="lbNext" aria-label="下一张">›</button>
    <div class="lb-stage" id="lbStage"><img id="lbImg" src="" alt="" /></div>
    <div class="lb-meta"><p id="lbTitle"></p><p id="lbEn"></p><p id="lbCount"></p></div>
    <div class="lb-swipe-hint">左右滑动切换 · 上下滑动关闭 · 双击放大</div>
  </div>

  <style>
    .gallery-page{max-width:1200px;margin:0 auto;padding:48px 20px 80px;background:#FAFAF8;color:#111}
    .gallery-head{text-align:center}
    .gallery-head h1{font-family:"Playfair Display","Noto Serif SC",serif;font-size:clamp(48px,8vw,96px);font-weight:400;line-height:1;margin:0}
    .sub{font-size:11px;letter-spacing:.22em;color:#666;margin:18px 0 0}
    .rule{height:1px;background:#ddd;margin:28px 0 18px}
    .filters{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:36px}
    .filters button{border:1px solid #ddd;background:#fff;padding:7px 14px;font-size:12px;cursor:pointer}
    .filters button.active{background:#111;color:#fff;border-color:#111}
    .gallery{columns:3;column-gap:28px}
    .item{break-inside:avoid;margin:0 0 36px}
    .item.hidden{display:none}
    .thumb-btn{width:100%;border:0;background:none;padding:0;cursor:zoom-in;text-align:left}
    .img-wrap{overflow:hidden;background:#eee;line-height:0}
    .img-wrap img{width:100%;height:auto;display:block;filter:grayscale(35%);transition:filter .4s,transform .6s}
    .thumb-btn:hover img{filter:grayscale(0);transform:scale(1.02)}
    figcaption{padding:12px 0 0}
    .cn{display:block;font-family:"Noto Serif SC",serif;font-size:16px}
    .en{display:block;font-size:10px;letter-spacing:.18em;color:#888;margin-top:4px}
    .rotate-hint{display:none;text-align:center;font-size:12px;color:#999;margin-top:20px}
    @media(max-width:820px){
      .gallery-page{padding:28px 16px 60px}
      .gallery{columns:1}
      .img-wrap img{filter:grayscale(0)}
      .gallery-head h1{font-size:48px}
      .sub{display:none}
      .rotate-hint{display:block}
    }
    .lightbox{position:fixed;inset:0;background:rgba(0,0,0,.94);z-index:9999;display:none;flex-direction:column;align-items:center;justify-content:center;color:#fff}
    .lightbox.open{display:flex}
    .lb-stage{width:100%;height:100dvh;display:flex;align-items:center;justify-content:center;overflow:hidden;touch-action:none}
    .lb-stage img{max-width:100vw;max-height:100dvh;object-fit:contain;transition:opacity .25s,transform .2s;transform-origin:center center}
    .lb-close{position:absolute;top:16px;right:20px;background:none;border:0;color:#fff;font-size:32px;cursor:pointer;z-index:2}
    .lb-prev,.lb-next{position:absolute;top:50%;transform:translateY(-50%);background:none;border:0;color:#fff;font-size:48px;cursor:pointer;padding:20px;z-index:2}
    .lb-prev{left:8px}.lb-next{right:8px}
    .lb-meta{position:absolute;bottom:0;left:0;right:0;text-align:center;padding:14px 0 calc(20px + env(safe-area-inset-bottom,0px));background:linear-gradient(transparent,rgba(0,0,0,.6));pointer-events:none}
    .lb-meta p{margin:2px 0;font-size:14px}.lb-meta p:nth-child(2){font-size:11px;letter-spacing:.16em;color:#aaa}
    .lb-meta p:last-child{font-size:12px;color:#888}
    .lb-swipe-hint{display:none;position:absolute;top:20px;left:0;right:0;text-align:center;font-size:11px;color:#888;pointer-events:none}
    @media(max-width:820px){
      .lb-prev,.lb-next{display:none}.lb-swipe-hint{display:block}
    }
  </style>

  <script define:vars={{ gallery }}>
    (function () {
      const data = gallery;
      let current = 0;
      let visible = data.map((_, i) => i);
      const lb = document.getElementById("lightbox");
      const lbImg = document.getElementById("lbImg");
      const lbTitle = document.getElementById("lbTitle");
      const lbEn = document.getElementById("lbEn");
      const lbCount = document.getElementById("lbCount");
      const stage = document.getElementById("lbStage");
      if (!lb || !lbImg) return;

      let zoomed = false;

      function render() {
        const idx = visible[current];
        const it = data[idx];
        if (!it) return;
        zoomed = false;
        lbImg.style.transform = "scale(1)";
        lbImg.style.opacity = "0.35";
        lbImg.src = it.thumb;
        const full = new Image();
        full.onload = () => { if (visible[current] === idx) { lbImg.src = it.url; lbImg.style.opacity = "1"; } };
        full.src = it.url;
        lbTitle.textContent = it.title || "";
        lbEn.textContent = it.en ? `${it.en} · ${it.date}` : (it.date || "");
        lbCount.textContent = `${current + 1} / ${visible.length}`;
      }
      function open(i) {
        current = visible.indexOf(i);
        if (current < 0) current = 0;
        render();
        lb.classList.add("open");
        lb.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }
      function close() {
        lb.classList.remove("open");
        lb.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
      function next() { if (!visible.length) return; current = (current + 1) % visible.length; render(); }
      function prev() { if (!visible.length) return; current = (current - 1 + visible.length) % visible.length; render(); }

      document.querySelectorAll(".thumb-btn").forEach((btn) => {
        btn.addEventListener("click", () => open(Number(btn.dataset.index)));
      });
      document.getElementById("lbClose").addEventListener("click", close);
      document.getElementById("lbNext").addEventListener("click", (e) => { e.stopPropagation(); next(); });
      document.getElementById("lbPrev").addEventListener("click", (e) => { e.stopPropagation(); prev(); });
      lb.addEventListener("click", (e) => { if (e.target === lb || e.target === stage) close(); });

      document.addEventListener("keydown", (e) => {
        if (!lb.classList.contains("open")) return;
        if (e.key === "Escape") close();
        else if (e.key === "ArrowRight") next();
        else if (e.key === "ArrowLeft") prev();
      });

      // 触摸手势：左右滑动切换、上下滑动关闭、双击放大/还原
      let sx = 0, sy = 0, st = 0;
      stage.addEventListener("touchstart", (e) => {
        const t = e.touches[0];
        sx = t.clientX; sy = t.clientY; st = Date.now();
      }, { passive: true });
      stage.addEventListener("touchend", (e) => {
        if (zoomed) return;
        const t = e.changedTouches[0];
        const dx = t.clientX - sx, dy = t.clientY - sy;
        const dt = Date.now() - st;
        if (Math.abs(dy) > 90 && Math.abs(dy) > Math.abs(dx)) { close(); return; }
        if (Math.abs(dx) > 45 && dt < 600) { dx < 0 ? next() : prev(); }
      }, { passive: true });

      let lastTap = 0;
      stage.addEventListener("click", () => {
        const now = Date.now();
        if (now - lastTap < 300) {
          zoomed = !zoomed;
          lbImg.style.transform = zoomed ? "scale(2)" : "scale(1)";
          lastTap = 0;
        } else {
          lastTap = now;
        }
      });

      // 筛选
      const filterBtns = document.querySelectorAll("#filters button");
      const items = document.querySelectorAll(".item");
      filterBtns.forEach((b) => {
        b.addEventListener("click", () => {
          const f = b.getAttribute("data-filter");
          filterBtns.forEach((x) => x.classList.toggle("active", x === b));
          visible = [];
          data.forEach((it, i) => {
            const show = f === "all" || (it.tags || []).includes(f);
            items[i].classList.toggle("hidden", !show);
            if (show) visible.push(i);
          });
        });
      });
    })();
  </script>
</MainLayout>
