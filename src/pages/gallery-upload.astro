---
import MainLayout from "../layouts/main.astro";
---

<MainLayout title="上传到画廊">
<main style="max-width:720px;margin:0 auto;padding:40px 20px">
  <h1 style="font-family:serif;font-size:42px">上传到画廊</h1>
  <p style="color:#666;font-size:13px;line-height:1.7">图片上传到图床后，自动生成 gallery.json 条目。复制结果追加到 <code>src/data/gallery.json</code> 即可。Token 只存在本机浏览器，不进仓库。</p>

  <label style="display:block;margin:24px 0 8px;font-size:13px">图床 API（已配置）</label>
  <input id="api" value="https://i.134688.xyz/upload?returnFormat=full" readonly style="width:100%;padding:12px;border:1px solid #ddd;box-sizing:border-box;background:#f7f7f7;font-size:13px" />

  <label style="display:block;margin:16px 0 8px;font-size:13px">Token（存 localStorage，不进 git）</label>
  <input id="token" type="password" placeholder="粘贴 imgbed_ 开头的 Token" style="width:100%;padding:12px;border:1px solid #ddd;box-sizing:border-box" />

  <div id="drop" style="margin:24px 0;border:2px dashed #ccc;padding:40px;text-align:center;cursor:pointer;font-size:14px">拖拽图片到这里，或点击选择<input id="file" type="file" accept="image/*" multiple hidden /></div>

  <div style="display:flex;gap:12px;flex-wrap:wrap">
    <input id="title" placeholder="标题，如：上下九步行街" style="flex:1;min-width:180px;padding:12px;border:1px solid #ddd;box-sizing:border-box" />
    <input id="en" placeholder="英文，如：SHANGXIAJIU · LIWAN" style="flex:1;min-width:180px;padding:12px;border:1px solid #ddd;box-sizing:border-box" />
  </div>
  <input id="tags" placeholder="标签，逗号分隔，如：street,guangzhou" value="street" style="width:100%;padding:12px;border:1px solid #ddd;box-sizing:border-box;margin-top:12px" />

  <button id="uploadBtn" style="margin-top:20px;width:100%;padding:14px;background:#111;color:#fff;border:0;font-size:15px;cursor:pointer">开始上传</button>
  <div id="progress" style="margin-top:16px;font-size:13px;color:#666"></div>
  <pre id="out" style="margin-top:16px;background:#f5f5f5;padding:16px;overflow:auto;font-size:12px;white-space:pre-wrap;word-break:break-all"></pre>
  <button id="copyBtn" style="display:none;margin-top:12px;padding:10px 16px;cursor:pointer">复制 JSON</button>
</main>

<script>
  const $ = (id) => document.getElementById(id);
  const tokenInput = $("token");
  tokenInput.value = localStorage.getItem("gallery_token") || "";
  tokenInput.onchange = () => localStorage.setItem("gallery_token", tokenInput.value.trim());

  const drop = $("drop"), file = $("file");
  drop.onclick = () => file.click();
  drop.ondragover = (e) => { e.preventDefault(); drop.style.borderColor = "#111"; };
  drop.ondragleave = () => { drop.style.borderColor = "#ccc"; };
  drop.ondrop = (e) => { e.preventDefault(); drop.style.borderColor = "#ccc"; file.files = e.dataTransfer.files; $("progress").textContent = `已选 ${file.files.length} 张`; };
  file.onchange = () => { $("progress").textContent = `已选 ${file.files.length} 张`; };

  function parseUrl(result) {
    const item = Array.isArray(result) ? result[0] : (result && result.result) || result;
    return item && (item.publicUrl || item.src || item.url) || "";
  }

  // 缩略图：图床支持 ?w= 实时缩放（注意是 w，不是 width）
  function toThumb(url) {
    try { const u = new URL(url); u.searchParams.set("w", "800"); u.searchParams.set("format", "webp"); return u.toString(); }
    catch { return url; }
  }

  $("uploadBtn").onclick = async () => {
    const api = $("api").value.trim();
    const token = tokenInput.value.trim();
    if (!file.files.length) return alert("先选图");
    if (!token) return alert("先填 Token");

    const title = $("title").value.trim();
    const en = $("en").value.trim();
    const tags = ($("tags").value || "street").split(",").map((s) => s.trim()).filter(Boolean);
    const results = [];

    for (let i = 0; i < file.files.length; i++) {
      const f = file.files[i];
      $("progress").textContent = `上传中 ${i + 1}/${file.files.length}：${f.name}`;
      const form = new FormData();
      form.append("file", f, f.name || "image");
      try {
        const res = await fetch(api, { method: "POST", headers: { Authorization: "Bearer " + token }, body: form });
        const json = await res.json().catch(() => null);
        if (!res.ok) throw new Error(`HTTP ${res.status} ${json ? JSON.stringify(json).slice(0, 120) : ""}`);
        const url = parseUrl(json);
        if (!url) throw new Error("未返回图片地址：" + JSON.stringify(json).slice(0, 160));
        const dims = await new Promise((resolve) => {
          const im = new Image();
          im.onload = () => resolve({ w: im.naturalWidth, h: im.naturalHeight });
          im.onerror = () => resolve({ w: 1200, h: 1600 });
          im.src = URL.createObjectURL(f);
        });
        results.push({
          id: Date.now() + "_" + i,
          url,
          thumb: toThumb(url),
          title: (title || f.name).replace(/\.[^.]+$/, ""),
          en,
          date: new Date().toISOString().slice(0, 10),
          width: dims.w,
          height: dims.h,
          orientation: dims.w >= dims.h ? "landscape" : "portrait",
          tags,
        });
      } catch (e) {
        $("progress").textContent = `${f.name} 失败：${e.message}`;
      }
    }
    $("out").textContent = JSON.stringify(results, null, 2);
    $("copyBtn").style.display = "block";
    $("progress").textContent = `完成 ${results.length} 张，复制后追加到 gallery.json 的数组里`;
  };

  $("copyBtn").onclick = async () => {
    try { await navigator.clipboard.writeText($("out").textContent); alert("已复制"); }
    catch { alert("复制失败，请手动选中复制"); }
  };
</script>
</MainLayout>
