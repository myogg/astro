---
import { getCollection } from "astro:content";
import Layout from "../../layouts/main.astro";

export async function getStaticPaths() {
	const albums = await getCollection("gallery");
	return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const { title, date, location, description, cover, photos } = album.data;
const dateText = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "long",
	day: "numeric",
}).format(date);
---

<Layout title={title} description={description || `${location} · ${photos.length} 张照片`} image={cover || photos[0].src}>
	<main class="album-detail mx-auto w-full max-w-5xl px-6 pb-24">
		<a class="back-link" href="/gallery/">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
			<span>所有图集</span>
		</a>
		<header class="album-header">
			<p class="album-eyebrow">{location} <span aria-hidden="true">·</span> {dateText}</p>
			<h1>{title}</h1>
			{description && <p class="album-description">{description}</p>}
			<p class="photo-total">{photos.length} 张照片</p>
		</header>

		<section class="photo-grid" aria-label={`${title}照片`}>
			{photos.map((photo, index) => (
				<button
					type="button"
					class="photo-card"
					data-photo-card
					data-index={index}
					data-caption={photo.caption || ""}
					aria-label={`查看照片 ${index + 1}：${photo.alt || photo.caption || title}`}
				>
					<img src={photo.src} alt={photo.alt || photo.caption || title} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
					{photo.caption && <span class="photo-caption">{photo.caption}</span>}
				</button>
			))}
		</section>
	</main>

	<dialog class="photo-viewer" id="photo-viewer" aria-label="照片查看器" data-album-title={title} data-location={location} data-date={dateText}>
		<div class="viewer-stage" id="viewer-stage">
			<div class="cube-scene" id="cube-scene"></div>
		</div>
		<button class="viewer-close" id="viewer-close" type="button" aria-label="关闭照片" title="关闭">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
		</button>
		<div class="viewer-actions">
			<button class="viewer-icon-button" id="viewer-share" type="button" aria-label="分享照片" title="分享照片">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" /></svg>
			</button>
			<p class="viewer-hint">左右滑动翻页 · 下滑关闭</p>
		</div>
	</dialog>

	<script>
		const cards = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-photo-card]"));
		const dialog = document.getElementById("photo-viewer") as HTMLDialogElement | null;
		const stage = document.getElementById("viewer-stage");
		const scene = document.getElementById("cube-scene");
		const albumTitle = dialog?.dataset.albumTitle || "照片图集";
		const albumLocation = dialog?.dataset.location || "";
		const albumDate = dialog?.dataset.date || "";
		const photos = cards.map((card) => {
			const img = card.querySelector("img") as HTMLImageElement;
			return {
				src: img.currentSrc || img.src,
				alt: img.alt || "",
				caption: card.dataset.caption || img.alt || "照片",
			};
		});
		const pad = (n: number) => String(n).padStart(2, "0");

		let current = 0;
		let dir = 0; // 1 下一张(左滑), -1 上一张(右滑)
		let theta = 0; // cube 当前 Y 轴角度
		let radius = 180; // 立方体半径 = 面宽的一半
		let dragging = false;
		let decided = false;
		let mode: "turn" | "close" | "" = "";
		let startX = 0;
		let startY = 0;
		let deltaX = 0;
		let deltaY = 0;
		let animating = false;

		function makeFace(photo: { src: string; alt: string; caption: string }, index: number) {
			const face = document.createElement("div");
			face.className = "cube-face";
			face.innerHTML = `
				<img class="face-blur" src="${photo.src}" alt="" aria-hidden="true" />
				<div class="face-scrim" aria-hidden="true"></div>
				<div class="face-head">
					<div>
						<p class="face-album">${albumTitle}</p>
						<p class="face-meta">${albumLocation} · ${albumDate}</p>
					</div>
					<p class="face-counter">${pad(index + 1)} / ${pad(photos.length)}</p>
				</div>
				<img class="face-img" src="${photo.src}" alt="${photo.alt}" />
				<div class="face-caption"><h2>${photo.caption}</h2></div>
				<span class="face-edge" aria-hidden="true"></span>
			`;
			const img = face.querySelector(".face-img") as HTMLImageElement;
			const detect = () => face.classList.toggle("is-portrait", img.naturalHeight > img.naturalWidth);
			if (img.complete && img.naturalWidth) detect();
			else img.addEventListener("load", detect, { once: true });
			return face;
		}

		function renderSingle(index: number) {
			if (!scene) return;
			radius = (stage?.clientWidth || 360) / 2;
			scene.innerHTML = "";
			const face = makeFace(photos[index], index);
			face.style.transform = `rotateY(0deg) translateZ(${radius}px)`;
			scene.appendChild(face);
			scene.style.transform = `translateZ(${-radius}px) rotateY(0deg)`;
			theta = 0;
			dir = 0;
		}

		function buildTurn(d: number) {
			if (!scene) return;
			radius = (stage?.clientWidth || 360) / 2;
			dir = d;
			const target = (current + d + photos.length) % photos.length;
			scene.innerHTML = "";
			const from = makeFace(photos[current], current);
			from.style.transform = `rotateY(0deg) translateZ(${radius}px)`;
			const to = makeFace(photos[target], target);
			// 下一张放在立方体右面(+90°),上一张放在左面(-90°)
			const faceAngle = d > 0 ? 90 : -90;
			to.style.transform = `rotateY(${faceAngle}deg) translateZ(${radius}px)`;
			scene.appendChild(from);
			scene.appendChild(to);
		}

		function applyTheta() {
			if (scene) scene.style.transform = `translateZ(${-radius}px) rotateY(${theta}deg)`;
		}

		function animateTo(endTheta: number, done: () => void) {
			if (!scene || window.matchMedia("(prefers-reduced-motion: reduce)").matches) { done(); return; }
			animating = true;
			const anim = scene.animate([
				{ transform: `translateZ(${-radius}px) rotateY(${theta}deg)` },
				{ transform: `translateZ(${-radius}px) rotateY(${endTheta}deg)` },
			], { duration: 340, easing: "cubic-bezier(.2,.8,.2,1)", fill: "forwards" });
			anim.onfinish = () => { anim.cancel(); animating = false; done(); };
		}

		function openFromThumbnail(index: number) {
			if (!dialog) return;
			current = index;
			decided = false;
			dragging = false;
			mode = "";
			dialog.showModal();
			requestAnimationFrame(() => renderSingle(current));
		}

		function closeToThumbnail() {
			if (!dialog || !scene) return;
			scene.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, easing: "ease" }).onfinish = () => dialog.close();
		}

		cards.forEach((card, index) => card.addEventListener("click", () => openFromThumbnail(index)));

		document.getElementById("viewer-close")?.addEventListener("click", closeToThumbnail);
		dialog?.addEventListener("click", (event) => { if (event.target === dialog) closeToThumbnail(); });
		dialog?.addEventListener("close", () => {
			const returnFocus = cards[current];
			requestAnimationFrame(() => returnFocus?.focus({ preventScroll: true }));
		});
		dialog?.addEventListener("cancel", (event) => { event.preventDefault(); closeToThumbnail(); });

		document.addEventListener("keydown", (event) => {
			if (!dialog?.open || animating) return;
			if (event.key === "Escape") { closeToThumbnail(); return; }
			if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
				const d = event.key === "ArrowRight" ? 1 : -1;
				buildTurn(d);
				animateTo(d > 0 ? -90 : 90, () => {
					current = (current + d + photos.length) % photos.length;
					renderSingle(current);
				});
			}
		});

		stage?.addEventListener("pointerdown", (event) => {
			if (!dialog?.open || animating) return;
			dragging = true;
			decided = false;
			mode = "";
			deltaX = 0;
			deltaY = 0;
			startX = event.clientX;
			startY = event.clientY;
		});
		window.addEventListener("pointermove", (event) => {
			if (!dragging) return;
			deltaX = event.clientX - startX;
			deltaY = event.clientY - startY;
			if (!decided) {
				if (Math.abs(deltaY) > Math.abs(deltaX) && deltaY > 34) {
					mode = "close";
					decided = true;
				} else if (Math.abs(deltaX) > 8) {
					mode = "turn";
					decided = true;
					buildTurn(deltaX < 0 ? 1 : -1);
				}
			}
			if (mode === "turn") {
				theta = (deltaX / (stage.clientWidth || 360)) * 90;
				applyTheta();
			} else if (mode === "close") {
				if (scene) scene.style.opacity = String(Math.max(0.15, 1 - Math.max(0, deltaY) / 400));
			}
		});
		function endPointer() {
			if (!dragging) return;
			dragging = false;
			if (mode === "turn") {
				const committed = Math.abs(theta) > 18;
				if (committed) {
					const endTheta = dir > 0 ? -90 : 90;
					animateTo(endTheta, () => {
						current = (current + dir + photos.length) % photos.length;
						renderSingle(current);
					});
				} else {
					animateTo(0, () => renderSingle(current));
				}
			} else if (mode === "close") {
				if (deltaY > 90) closeToThumbnail();
				else if (scene) { scene.style.opacity = "1"; renderSingle(current); }
			}
			mode = "";
		}
		window.addEventListener("pointerup", endPointer);
		window.addEventListener("pointercancel", endPointer);

		document.getElementById("viewer-share")?.addEventListener("click", async () => {
			try {
				if (navigator.share) await navigator.share({ title: albumTitle, text: `${albumTitle} · ${albumLocation}`, url: location.href });
				else if (navigator.clipboard) await navigator.clipboard.writeText(location.href);
			} catch {
				// 用户取消分享时无需提示。
			}
		});
	</script>

	<style>
		.album-detail { color: #171717; }
		.back-link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1.5rem; color: #8a8a8a; font-size: 0.8rem; text-decoration: none; transition: color 150ms ease; }
		.back-link:hover { color: #171717; }
		.back-link svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
		.album-header { padding: 2.3rem 0 2rem; text-align: center; }
		.album-eyebrow { margin: 0 0 0.75rem; color: #999; font-size: 0.78rem; letter-spacing: 0.08em; }
		.album-header h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.65rem); font-weight: 500; letter-spacing: 0.04em; line-height: 1.35; }
		.album-description { max-width: 40rem; margin: 0.7rem auto 0; color: #858585; font-size: 0.9rem; line-height: 1.7; }
		.photo-total { margin: 0.65rem 0 0; color: #aaa; font-size: 0.74rem; }
		.photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: auto; gap: 3px; }
		.photo-card { position: relative; overflow: hidden; aspect-ratio: 1; border: 0; border-radius: 0; padding: 0; background: #e5e5e5; cursor: zoom-in; }
		.photo-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 450ms ease; }
		.photo-card:hover img { transform: scale(1.04); }
		.photo-caption { position: absolute; right: 0.45rem; bottom: 0.4rem; left: 0.45rem; color: white; opacity: 0; text-align: left; text-shadow: 0 1px 5px rgb(0 0 0 / 45%); font-size: 0.75rem; transition: opacity 150ms ease; }
		.photo-card:hover .photo-caption, .photo-card:focus-visible .photo-caption { opacity: 1; }
		:global(html.dark) .album-detail { color: #f5f5f5; }
		:global(html.dark) .back-link:hover { color: white; }
		:global(html.dark) .photo-card { border-color: rgb(255 255 255 / 7%); }

		/* ---------- 全屏立方体查看器 ---------- */
		.photo-viewer { width: 100vw; max-width: none; max-height: none; height: 100dvh; margin: 0; border: 0; padding: 0; overflow: hidden; background: #000; color: white; }
		.photo-viewer[open] { display: block; }
		.photo-viewer::backdrop { background: #000; }
		.viewer-stage { position: absolute; inset: 0; perspective: 1200px; perspective-origin: center center; touch-action: none; overflow: hidden; }
		.cube-scene { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
		:global(.cube-face) { position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; transform-style: preserve-3d; background: #101012; box-shadow: 0 0 40px rgb(0 0 0 / 60%); }
		:global(.face-blur) { position: absolute; inset: -24px; width: calc(100% + 48px); height: calc(100% + 48px); object-fit: cover; filter: blur(28px) brightness(0.5); transform: scale(1.06); }
		:global(.face-scrim) { position: absolute; inset: 0; background: linear-gradient(rgb(0 0 0 / 32%), transparent 28%, transparent 56%, rgb(0 0 0 / 70%)); }
		:global(.face-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
		/* 竖图：完整显示、上下留纯黑边（不裁切、不模糊填充） */
		:global(.cube-face.is-portrait) { background: #000; }
		:global(.cube-face.is-portrait .face-img) { inset: 11% 0 15% 0; width: 100%; height: 74%; object-fit: contain; }
		:global(.cube-face.is-portrait .face-blur) { display: none; }
		:global(.face-head) { position: absolute; z-index: 3; top: 0; right: 0; left: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: max(1rem, env(safe-area-inset-top)) 1rem 1.8rem; background: linear-gradient(rgb(0 0 0 / 30%), transparent); }
		:global(.face-album) { margin: 0; font-size: 0.92rem; font-weight: 600; }
		:global(.face-meta) { margin: 0.25rem 0 0; color: rgb(255 255 255 / 78%); font-size: 0.76rem; }
		:global(.face-counter) { margin: 0; font-size: 0.82rem; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
		:global(.face-caption) { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; padding: 4.5rem 1.1rem max(1.6rem, env(safe-area-inset-bottom)); background: linear-gradient(transparent, rgb(0 0 0 / 72%)); text-align: left; }
		:global(.face-caption h2) { margin: 0; font-size: 1.05rem; font-weight: 500; line-height: 1.5; }
		:global(.face-edge) { position: absolute; z-index: 4; top: 0; right: 0; bottom: 0; width: 3px; background: linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 28%), rgb(255 255 255 / 5%)); pointer-events: none; }
		.viewer-close { position: absolute; z-index: 20; top: max(0.9rem, env(safe-area-inset-top)); right: 0.85rem; width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / 28%); border-radius: 999px; background: rgb(0 0 0 / 25%); color: white; cursor: pointer; }
		.viewer-close:hover { background: rgb(255 255 255 / 16%); }
		.viewer-close svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.7; }
		.viewer-actions { position: absolute; z-index: 20; left: 0; right: 0; bottom: max(0.5rem, env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; gap: 0.4rem; pointer-events: none; }
		.viewer-icon-button { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / 28%); border-radius: 999px; background: rgb(0 0 0 / 24%); color: white; cursor: pointer; pointer-events: auto; }
		.viewer-icon-button svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
		.viewer-hint { margin: 0; color: rgb(255 255 255 / 62%); font-size: 0.7rem; }

		@media (max-width: 767px) {
			.album-header { padding: 1.8rem 0 1.4rem; }
			.album-description { font-size: 0.84rem; }
			.photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; margin-right: -1.5rem; margin-left: -1.5rem; }
			.photo-card { border-radius: 0; }
			.photo-caption { display: none; }
			:global(.face-head) { padding: max(0.9rem, env(safe-area-inset-top)) 0.85rem 1.8rem; }
			:global(.face-album) { font-size: 0.86rem; }
			:global(.face-meta) { font-size: 0.69rem; }
			:global(.face-counter) { font-size: 0.74rem; }
			:global(.face-caption) { padding: 3.5rem 0.9rem max(1.2rem, env(safe-area-inset-bottom)); }
			:global(.face-caption h2) { font-size: 0.98rem; }
		}
		@media (prefers-reduced-motion: reduce) { .photo-card img, .photo-caption, .back-link { transition: none; } }
	</style>
</Layout>
