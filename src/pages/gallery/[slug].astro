---
import { getCollection } from "astro:content";
import Layout from "../../layouts/main.astro";

export async function getStaticPaths() {
	const albums = await getCollection("gallery");
	return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const { title, date, location, description, cover, photos } = album.data;
const dateText = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "long",
	day: "numeric",
}).format(date);
---

<Layout title={title} description={description || `${location} · ${photos.length} 张照片`} image={cover || photos[0].src}>
	<main class="album-detail mx-auto w-full max-w-5xl px-6 pb-24">
		<a class="back-link" href="/gallery/">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
			<span>所有图集</span>
		</a>
		<header class="album-header">
			<p class="album-eyebrow">{location} <span aria-hidden="true">·</span> {dateText}</p>
			<h1>{title}</h1>
			{description && <p class="album-description">{description}</p>}
			<p class="photo-total">{photos.length} 张照片</p>
		</header>

		<section class="photo-grid" aria-label={`${title}照片`}>
			{photos.map((photo, index) => (
				<button
					type="button"
					class="photo-card"
					data-photo-card
					data-index={index}
					data-caption={photo.caption || ""}
					aria-label={`查看照片 ${index + 1}：${photo.alt || photo.caption || title}`}
				>
					<img src={photo.src} alt={photo.alt || photo.caption || title} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
					{photo.caption && <span class="photo-caption">{photo.caption}</span>}
				</button>
			))}
		</section>
	</main>

	<dialog class="photo-viewer" id="photo-viewer" aria-label="照片查看器" data-album-title={title} data-location={location} data-date={dateText}>
		<div class="viewer-wrap">
			<article class="viewer-card" id="viewer-card">
				<img class="viewer-blur" id="viewer-blur" src="" alt="" aria-hidden="true" />
				<div class="viewer-scrim" aria-hidden="true"></div>
				<header class="viewer-header">
					<div class="viewer-context">
						<p class="viewer-album-title">{title}</p>
						<p class="viewer-meta" id="viewer-meta"></p>
					</div>
					<div class="viewer-toolbar">
						<p class="viewer-counter" id="viewer-counter" aria-live="polite"></p>
						<button class="viewer-icon-button" id="viewer-close" type="button" aria-label="关闭照片" title="关闭">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
						</button>
					</div>
				</header>
				<div class="viewer-stage" id="viewer-stage">
					<button class="viewer-arrow viewer-prev" id="viewer-prev" type="button" aria-label="上一张照片">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
					</button>
					<img id="viewer-image" class="viewer-image" src="" alt="" />
					<button class="viewer-arrow viewer-next" id="viewer-next" type="button" aria-label="下一张照片">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
					</button>
				</div>
				<footer class="viewer-caption">
					<h2 id="viewer-title"></h2>
				</footer>
			</article>
			<div class="viewer-actions">
				<button class="viewer-icon-button" id="viewer-share" type="button" aria-label="分享照片" title="分享照片">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" /></svg>
				</button>
				<p class="viewer-hint">左右滑动切换 · 下滑返回图集</p>
			</div>
		</div>
	</dialog>

	<script>
		const cards = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-photo-card]"));
		const dialog = document.getElementById("photo-viewer") as HTMLDialogElement | null;
		const albumTitle = dialog?.dataset.albumTitle || "照片图集";
		const albumLocation = dialog?.dataset.location || "";
		const albumDate = dialog?.dataset.date || "";
		const viewerWrap = document.querySelector(".viewer-wrap");
		const viewerCard = document.getElementById("viewer-card");
		const viewerBlur = document.getElementById("viewer-blur") as HTMLImageElement | null;
		const viewerImage = document.getElementById("viewer-image") as HTMLImageElement | null;
		const viewerTitle = document.getElementById("viewer-title");
		const viewerMeta = document.getElementById("viewer-meta");
		const viewerCounter = document.getElementById("viewer-counter");
		const stage = document.getElementById("viewer-stage");
		let activePosition = 0;
		let activeCard: HTMLButtonElement | null = null;
		let touchStartX = 0;
		let touchStartY = 0;
		let pinchStartDistance = 0;
		let shouldCloseByPinch = false;
		let isClosing = false;
		let isTurning = false;

		function getTouchDistance(touches: TouchList) {
			if (touches.length < 2) return 0;
			const first = touches.item(0);
			const second = touches.item(1);
			if (!first || !second) return 0;
			return Math.hypot(second.clientX - first.clientX, second.clientY - first.clientY);
		}

		function animateBetween(from: DOMRect, to: DOMRect) {
			if (!viewerCard || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return null;
			const scaleX = Math.max(0.01, from.width / to.width);
			const scaleY = Math.max(0.01, from.height / to.height);
			return viewerCard.animate([
				{ transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${scaleX}, ${scaleY})`, borderRadius: "4px" },
				{ transform: "translate(0, 0) scale(1, 1)", borderRadius: "15px" },
			], { duration: 300, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
		}

		function clearCubeTransition() {
			viewerCard?.getAnimations().forEach((animation) => animation.cancel());
			viewerWrap?.querySelectorAll(".viewer-face-outgoing").forEach((face) => face.remove());
			viewerCard?.classList.remove("is-cube-incoming", "cube-next", "cube-previous");
			isTurning = false;
		}

		function animateCubeTransition(outgoing: HTMLElement, direction: number) {
			if (!viewerWrap || !viewerCard || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				outgoing.remove();
				return;
			}
			clearCubeTransition();
			const directionClass = direction > 0 ? "cube-next" : "cube-previous";
			const next = direction > 0;
			outgoing.classList.add("viewer-face-outgoing", directionClass);
			viewerCard.classList.add("is-cube-incoming", directionClass);
			viewerWrap.appendChild(outgoing);
			isTurning = true;
			const duration = 560;
			const outgoingAnimation = outgoing.animate([
				{ transform: "rotateY(0deg)", transformOrigin: next ? "left center" : "right center", filter: "brightness(1)" },
				{ transform: `rotateY(${next ? "-90deg" : "90deg"})`, transformOrigin: next ? "left center" : "right center", filter: "brightness(0.55)" },
			], { duration, easing: "cubic-bezier(0.45, 0, 0.2, 1)" });
			const incomingAnimation = viewerCard.animate([
				{ transform: `rotateY(${next ? "90deg" : "-90deg"})`, transformOrigin: next ? "right center" : "left center", filter: "brightness(0.45)" },
				{ transform: "rotateY(0deg)", transformOrigin: next ? "right center" : "left center", filter: "brightness(1)" },
			], { duration, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
			Promise.allSettled([outgoingAnimation.finished, incomingAnimation.finished]).then(() => {
				outgoing.remove();
				viewerCard.classList.remove("is-cube-incoming", "cube-next", "cube-previous");
				isTurning = false;
			});
		}

		function closeToThumbnail() {
			if (!dialog?.open || isClosing) return;
			clearCubeTransition();
			if (!activeCard || !viewerCard) {
				dialog.close();
				return;
			}
			isClosing = true;
			const from = viewerCard.getBoundingClientRect();
			const to = activeCard.getBoundingClientRect();
			const animation = animateBetween(from, to);
			if (!animation) {
				isClosing = false;
				dialog.close();
				return;
			}
			animation.onfinish = () => {
				isClosing = false;
				dialog.close();
			};
		}

		function updatePhoto(direction = 0) {
			const card = cards[activePosition];
			const source = card?.querySelector("img");
			if (!card || !source || !viewerImage || !viewerBlur || !viewerTitle || !viewerMeta || !viewerCounter) return;
			const outgoing = direction && viewerCard ? viewerCard.cloneNode(true) as HTMLElement : null;
			if (outgoing) {
				outgoing.removeAttribute("id");
				outgoing.querySelectorAll("[id]").forEach((element) => element.removeAttribute("id"));
				outgoing.setAttribute("aria-hidden", "true");
			}
			viewerImage.src = source.currentSrc || source.src;
			viewerBlur.src = source.currentSrc || source.src;
			viewerImage.alt = source.alt;
			viewerTitle.textContent = card.dataset.caption || source.alt || "照片";
			viewerMeta.textContent = `${albumLocation} · ${albumDate}`;
			viewerCounter.textContent = `${String(activePosition + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
			if (outgoing && direction) animateCubeTransition(outgoing, direction);
		}

		function movePhoto(direction: number) {
			if (!cards.length || isTurning || isClosing) return;
			activePosition = (activePosition + direction + cards.length) % cards.length;
			activeCard = cards[activePosition];
			updatePhoto(direction);
		}

		function openFromThumbnail(card: HTMLButtonElement, index: number) {
			if (!dialog || !viewerCard) return;
			clearCubeTransition();
			activeCard = card;
			activePosition = index;
			isClosing = false;
			updatePhoto();
			dialog.showModal();
			requestAnimationFrame(() => {
				const from = card.getBoundingClientRect();
				const to = viewerCard.getBoundingClientRect();
				animateBetween(from, to);
			});
		}

		cards.forEach((card, index) => {
			card.addEventListener("click", () => openFromThumbnail(card, index));
		});

		document.getElementById("viewer-close")?.addEventListener("click", closeToThumbnail);
		document.getElementById("viewer-prev")?.addEventListener("click", () => movePhoto(-1));
		document.getElementById("viewer-next")?.addEventListener("click", () => movePhoto(1));
		dialog?.addEventListener("click", (event) => {
			if (event.target === dialog) closeToThumbnail();
		});
		dialog?.addEventListener("close", () => {
			const returnFocus = activeCard;
			requestAnimationFrame(() => returnFocus?.focus({ preventScroll: true }));
		});
		dialog?.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeToThumbnail();
		});
		dialog?.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") movePhoto(-1);
			if (event.key === "ArrowRight") movePhoto(1);
		});
		stage?.addEventListener("touchstart", (event) => {
			touchStartX = event.changedTouches[0]?.clientX || 0;
			touchStartY = event.changedTouches[0]?.clientY || 0;
			pinchStartDistance = getTouchDistance(event.touches);
			shouldCloseByPinch = false;
		}, { passive: true });
		stage?.addEventListener("touchmove", (event) => {
			const currentDistance = getTouchDistance(event.touches);
			if (pinchStartDistance > 0 && currentDistance > 0 && currentDistance < pinchStartDistance * 0.68) {
				shouldCloseByPinch = true;
			}
		}, { passive: true });
		stage?.addEventListener("touchend", (event) => {
			if (shouldCloseByPinch) {
				shouldCloseByPinch = false;
				pinchStartDistance = 0;
				closeToThumbnail();
				return;
			}
			const touch = event.changedTouches[0];
			const distanceX = (touch?.clientX || 0) - touchStartX;
			const distanceY = (touch?.clientY || 0) - touchStartY;
			if (distanceY > 76 && Math.abs(distanceY) > Math.abs(distanceX) * 1.2) {
				closeToThumbnail();
				return;
			}
			if (Math.abs(distanceX) > 48 && Math.abs(distanceX) > Math.abs(distanceY)) movePhoto(distanceX > 0 ? -1 : 1);
		}, { passive: true });
		document.getElementById("viewer-share")?.addEventListener("click", async () => {
			const source = cards[activePosition]?.querySelector("img");
			if (!source) return;
			const shareData = { title: cards[activePosition]?.dataset.caption || albumTitle, text: `${albumTitle} · ${albumLocation}`, url: source.src };
			try {
				if (navigator.share) await navigator.share(shareData);
				else if (navigator.clipboard) await navigator.clipboard.writeText(shareData.url);
			} catch {
				// 用户取消分享时无需额外提示。
			}
		});
	</script>

	<style>
		.album-detail { color: #171717; }
		.back-link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1.5rem; color: #8a8a8a; font-size: 0.8rem; text-decoration: none; transition: color 150ms ease; }
		.back-link:hover { color: #171717; }
		.back-link svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
		.album-header { padding: 2.3rem 0 2rem; text-align: center; }
		.album-eyebrow { margin: 0 0 0.75rem; color: #999; font-size: 0.78rem; letter-spacing: 0.08em; }
		.album-header h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.65rem); font-weight: 500; letter-spacing: 0.04em; line-height: 1.35; }
		.album-description { max-width: 40rem; margin: 0.7rem auto 0; color: #858585; font-size: 0.9rem; line-height: 1.7; }
		.photo-total { margin: 0.65rem 0 0; color: #aaa; font-size: 0.74rem; }
		.photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: auto; gap: 3px; }
		.photo-card { position: relative; overflow: hidden; aspect-ratio: 1; border: 0; border-radius: 0; padding: 0; background: #e5e5e5; cursor: zoom-in; }
		.photo-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 450ms ease; }
		.photo-card:hover img { transform: scale(1.04); }
		.photo-caption { position: absolute; right: 0.45rem; bottom: 0.4rem; left: 0.45rem; color: white; opacity: 0; text-align: left; text-shadow: 0 1px 5px rgb(0 0 0 / 45%); font-size: 0.75rem; transition: opacity 150ms ease; }
		.photo-card:hover .photo-caption, .photo-card:focus-visible .photo-caption { opacity: 1; }
		:global(html.dark) .album-detail { color: #f5f5f5; }
		:global(html.dark) .back-link:hover { color: white; }
		:global(html.dark) .photo-card { border-color: rgb(255 255 255 / 7%); }

		.photo-viewer { width: 100vw; max-width: none; max-height: none; height: 100dvh; margin: 0; border: 0; padding: 1rem; overflow: hidden; background: transparent; color: white; }
		.photo-viewer[open] { display: flex; align-items: center; justify-content: center; }
		.photo-viewer::backdrop { background: rgb(0 0 0 / 94%); }
		.viewer-wrap { position: relative; display: flex; width: 100%; height: 100%; max-width: 680px; flex-direction: column; align-items: center; justify-content: center; gap: 0.55rem; margin: 0 auto; perspective: 1100px; perspective-origin: center center; }
		.viewer-card { position: relative; width: 100%; height: min(82dvh, 900px); min-height: 0; flex: 1 1 auto; overflow: hidden; border-radius: 18px; background: #353638; box-shadow: 0 24px 80px rgb(0 0 0 / 35%); backface-visibility: hidden; transform-origin: top left; transform-style: preserve-3d; }
		.viewer-card.is-cube-incoming { z-index: 4; overflow: visible; }
		.viewer-card.is-cube-incoming::after, .viewer-face-outgoing::after { position: absolute; z-index: 5; top: 0; bottom: 0; width: 28px; background: linear-gradient(90deg, #141414, #777 48%, #202020); box-shadow: inset 0 0 16px rgb(0 0 0 / 45%); content: ""; pointer-events: none; backface-visibility: hidden; }
		.viewer-face-outgoing { position: absolute; z-index: 6; inset: 0 0 3.35rem; width: auto; height: auto; flex: none; overflow: visible; border-radius: 18px; box-shadow: none; pointer-events: none; }
		.viewer-face-outgoing.cube-next::after { right: -28px; transform: rotateY(90deg); transform-origin: left center; }
		.viewer-card.is-cube-incoming.cube-next::after { left: -28px; transform: rotateY(-90deg); transform-origin: right center; }
		.viewer-face-outgoing.cube-previous::after { left: -28px; transform: rotateY(-90deg); transform-origin: right center; }
		.viewer-card.is-cube-incoming.cube-previous::after { right: -28px; transform: rotateY(90deg); transform-origin: left center; }
		.viewer-blur { position: absolute; inset: -24px; width: calc(100% + 48px); height: calc(100% + 48px); object-fit: cover; filter: blur(28px) brightness(0.58); transform: scale(1.06); }
		.viewer-scrim { position: absolute; z-index: 1; inset: 0; background: linear-gradient(rgb(0 0 0 / 30%), transparent 32%, transparent 58%, rgb(0 0 0 / 65%)); }
		.viewer-header { position: absolute; z-index: 3; top: 0; right: 0; left: 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1rem 1.8rem; background: linear-gradient(rgb(0 0 0 / 28%), transparent); }
		.viewer-context { min-width: 0; }
		.viewer-album-title { overflow: hidden; margin: 0; color: white; font-size: 0.92rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
		.viewer-meta { margin: 0.25rem 0 0; color: rgb(255 255 255 / 78%); font-size: 0.76rem; }
		.viewer-toolbar { display: flex; flex: 0 0 auto; align-items: center; gap: 0.75rem; }
		.viewer-counter { margin: 0; color: white; font-size: 0.8rem; letter-spacing: 0.08em; }
		.viewer-actions { display: flex; width: 100%; min-height: 2.8rem; flex: 0 0 2.8rem; align-items: center; justify-content: center; gap: 0.75rem; }
		.viewer-hint { margin: 0; color: #999; font-size: 0.72rem; }
		.viewer-icon-button, .viewer-arrow { display: grid; place-items: center; border: 1px solid rgb(255 255 255 / 28%); border-radius: 999px; background: rgb(0 0 0 / 24%); color: white; cursor: pointer; transition: background 160ms ease, border-color 160ms ease; }
		.viewer-icon-button { width: 2.5rem; height: 2.5rem; }
		.viewer-icon-button:hover, .viewer-arrow:hover { border-color: rgb(255 255 255 / 60%); background: rgb(255 255 255 / 16%); }
		.viewer-icon-button svg, .viewer-arrow svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
		.viewer-stage { position: absolute; z-index: 2; inset: 0; display: flex; align-items: center; justify-content: center; padding: 4.5rem 0 5rem; touch-action: none; }
		.viewer-image { position: relative; z-index: 1; display: block; width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; }
		.viewer-arrow { position: absolute; z-index: 2; top: 50%; width: 2.55rem; height: 2.55rem; transform: translateY(-50%); background: rgb(0 0 0 / 25%); }
		.viewer-prev { left: 0.65rem; }
		.viewer-next { right: 0.65rem; }
		.viewer-caption { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; padding: 4rem 1.1rem 1.2rem; background: linear-gradient(transparent, rgb(0 0 0 / 68%)); text-align: left; }
		.viewer-caption h2 { margin: 0; color: white; font-size: 1.05rem; font-weight: 500; line-height: 1.5; }

		@media (max-width: 767px) {
			.album-header { padding: 1.8rem 0 1.4rem; }
			.album-description { font-size: 0.84rem; }
			.photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; margin-right: -1.5rem; margin-left: -1.5rem; }
			.photo-card { border-radius: 0; }
			.photo-caption { display: none; }
			.photo-viewer { padding: max(0.5rem, env(safe-area-inset-top)) 0.5rem max(0.5rem, env(safe-area-inset-bottom)); }
			.viewer-wrap { gap: 0.35rem; }
			.viewer-card { height: calc(100dvh - 4.2rem); border-radius: 15px; }
			.viewer-header { padding: max(0.9rem, env(safe-area-inset-top)) 0.85rem 1.8rem; }
			.viewer-album-title { font-size: 0.86rem; }
			.viewer-meta { font-size: 0.69rem; }
			.viewer-toolbar { gap: 0.5rem; }
			.viewer-counter { font-size: 0.72rem; }
			.viewer-stage { padding: 4.4rem 0 5.2rem; }
			.viewer-arrow { width: 2.2rem; height: 2.2rem; }
			.viewer-prev { left: 0.45rem; }
			.viewer-next { right: 0.45rem; }
			.viewer-caption { padding: 3.5rem 0.9rem 1rem; }
			.viewer-caption h2 { font-size: 0.98rem; }
		}
		@media (prefers-reduced-motion: reduce) { .photo-card img, .photo-caption, .back-link, .viewer-icon-button, .viewer-arrow { transition: none; } }
	</style>
</Layout>
