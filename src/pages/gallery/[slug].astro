---
import Layout from "../../layouts/main.astro";
import PageHeading from "../../components/page-heading.astro";
import galleryData from "../../data/gallery.json";

type Photo = { url: string; thumb?: string; caption?: string; date?: string };
type Group = { name: string; slug?: string; date?: string; photos: Photo[] };
type GalleryData = { title: string; description: string; groups: Group[] };

const data = galleryData as GalleryData;

export function getStaticPaths() {
  const d = galleryData as GalleryData;
  return (d.groups || [])
    .filter((g) => g.slug)
    .map((g) => ({
      params: { slug: g.slug as string },
      props: { group: g },
    }));
}

const { group } = Astro.props as { group: Group };

let counter = 0;
const photos = (group.photos || []).map((p) => ({
  full: p.url,
  thumb: p.thumb || p.url,
  caption: p.caption || "",
  idx: counter++,
}));
const description = `${group.name} · 共 ${photos.length} 张`;
const backHref = "/gallery/";
---

<Layout title={group.name} description={description}>
  <section class="relative z-20 max-w-5xl mx-auto my-12 px-7 lg:px-0">
    <a
      href={backHref}
      class="inline-flex items-center gap-1.5 mb-6 text-sm text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition"
    >
      <span aria-hidden="true">←</span> 返回画廊
    </a>
    <div class="pb-6 border-b border-dashed border-neutral-300 dark:border-neutral-700">
      <PageHeading title={group.name} description={description} />
    </div>

    {
      photos.length === 0 ? (
        <p class="mt-10 text-sm text-neutral-500 dark:text-neutral-400">这组还没有照片。</p>
      ) : (
        <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 mt-10">
          {
            photos.map((item) => (
              <button
                type="button"
                data-gallery-index={item.idx}
                aria-label={`查看大图：${item.caption || "照片"}`}
                class="gallery-item group relative mb-4 block w-full break-inside-avoid overflow-hidden rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900"
              >
                <img
                  src={item.thumb}
                  alt={item.caption || "照片"}
                  loading="lazy"
                  class="block w-full h-auto transition duration-300 ease-out group-hover:scale-[1.02]"
                />
                {item.caption && (
                  <span class="block px-3 py-2 text-left text-xs leading-5 text-neutral-500 dark:text-neutral-400">
                    {item.caption}
                  </span>
                )}
              </button>
            ))
          }
        </div>
      )
    }
  </section>

  <dialog id="lightbox" class="lb" aria-label="照片大图">
    <div class="lb-stage" id="lb-stage">
      <img id="lightbox-img" src="" alt="" draggable="false" />
      <button id="lightbox-prev" type="button" aria-label="上一张" class="lb-nav lb-prev">‹</button>
      <button id="lightbox-next" type="button" aria-label="下一张" class="lb-nav lb-next">›</button>
    </div>
    <div class="lb-bar">
      <span id="lightbox-caption" class="lb-caption"></span>
      <span id="lightbox-count" class="lb-count"></span>
    </div>
    <button id="lightbox-close" type="button" aria-label="关闭" class="lb-close">×</button>
  </dialog>

  <style>
    .lb {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: #000;
      overflow: hidden;
      color: #fff;
    }
    .lb-stage {
      position: absolute;
      inset: 0;
      box-sizing: border-box;
      padding: 10px 6px 54px;
      display: flex;
      align-items: center;
      justify-content: center;
      touch-action: pan-y;
    }
    .lb-stage img {
      display: block;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      -webkit-user-select: none;
      user-select: none;
      -webkit-user-drag: none;
      transition: opacity 0.15s ease;
    }
    .lb-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 9999px;
      background: rgba(0, 0, 0, 0.4);
      color: #fff;
      font-size: 32px;
      line-height: 1;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .lb-prev { left: 8px; }
    .lb-next { right: 8px; }
    .lb-close {
      position: absolute;
      top: max(10px, env(safe-area-inset-top));
      right: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 0;
      border-radius: 9999px;
      background: rgba(0, 0, 0, 0.45);
      color: #fff;
      font-size: 26px;
      line-height: 1;
      cursor: pointer;
      z-index: 3;
      -webkit-tap-highlight-color: transparent;
    }
    .lb-bar {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgba(0, 0, 0, 0.6);
    }
    .lb-caption { font-size: 14px; }
    .lb-count { font-size: 12px; opacity: 0.7; font-variant-numeric: tabular-nums; white-space: nowrap; }
  </style>
  <style is:global>
    #lightbox::backdrop { background: #000; }
  </style>

  <script is:inline define:vars={{ photos }}>
    (function () {
      const dialog = document.getElementById("lightbox");
      const stage = document.getElementById("lb-stage");
      const img = document.getElementById("lightbox-img");
      const caption = document.getElementById("lightbox-caption");
      const count = document.getElementById("lightbox-count");
      if (!dialog || !img || !photos || !photos.length) return;

      let current = 0;
      function show(idx) {
        current = (idx + photos.length) % photos.length;
        const p = photos[current];
        img.style.opacity = "0";
        const pre = new Image();
        pre.onload = pre.onerror = function () {
          img.src = p.full;
          img.alt = p.caption || "照片";
          img.style.opacity = "1";
        };
        pre.src = p.full;
        caption.textContent = p.caption || "";
        count.textContent = current + 1 + " / " + photos.length;
      }
      function close() { if (dialog.open) dialog.close(); }
      function next() { show(current + 1); }
      function prev() { show(current - 1); }

      document.querySelectorAll("[data-gallery-index]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          show(Number(btn.getAttribute("data-gallery-index")));
          dialog.showModal();
        });
      });
      document.getElementById("lightbox-prev")?.addEventListener("click", function (e) { e.stopPropagation(); prev(); });
      document.getElementById("lightbox-next")?.addEventListener("click", function (e) { e.stopPropagation(); next(); });
      document.getElementById("lightbox-close")?.addEventListener("click", close);

      // 点击图片左右两侧切换（中间保留，避免误触）
      let didSwipe = false;
      stage.addEventListener("click", function (e) {
        if (didSwipe) { didSwipe = false; return; }
        if (e.target.closest("button")) return;
        const x = e.clientX;
        const w = window.innerWidth;
        if (x < w * 0.32) prev();
        else if (x > w * 0.68) next();
      });

      // 触摸左右滑动切换
      let startX = 0, startY = 0, moveX = 0;
      stage.addEventListener("touchstart", function (e) {
        if (e.touches.length !== 1) return;
        didSwipe = false;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        moveX = 0;
      }, { passive: true });
      stage.addEventListener("touchmove", function (e) {
        if (!e.touches.length) return;
        moveX = e.touches[0].clientX - startX;
      }, { passive: true });
      stage.addEventListener("touchend", function (e) {
        const dx = moveX;
        const dy = Math.abs((e.changedTouches[0] && e.changedTouches[0].clientY || startY) - startY);
        if (Math.abs(dx) > 45 && Math.abs(dx) > dy) {
          didSwipe = true;
          if (dx < 0) next(); else prev();
        }
        moveX = 0;
      }, { passive: true });

      document.addEventListener("keydown", function (e) {
        if (!dialog.open) return;
        if (e.key === "ArrowLeft") prev();
        else if (e.key === "ArrowRight") next();
        else if (e.key === "Escape") close();
      });
    })();
  </script>
</Layout>
