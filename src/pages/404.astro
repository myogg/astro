---
import Layout from "../layouts/main.astro";
import Button from "../components/button.astro";
---

<Layout title="404" description="页面不存在" noindex>
  <section class="relative z-20 max-w-2xl mx-auto my-24 px-7 lg:px-0 text-center">
    <p class="text-7xl font-bold tracking-tighter text-neutral-900 dark:text-neutral-100">404</p>
    <h1 class="mt-6 text-xl font-bold dark:text-neutral-200 sm:text-2xl">这个页面不存在</h1>
    <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:text-base">
      链接可能过期了，或者地址敲错了。
    </p>
    <div class="flex items-center justify-center gap-3">
      <Button link="/" text="回首页" />
      <Button link="/posts/" text="全部文章" />
    </div>
  </section>
</Layout>
