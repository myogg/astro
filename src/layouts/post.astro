---
import Layout from "./main.astro";
import { formatDisplayDate } from "../utils/date";
const { frontmatter, shareImage, audioId, audioSlug } = Astro.props;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={shareImage || frontmatter.image}
  ogType="article"
  publishedTime={frontmatter.date.toISOString()}
>
  <main
    class="relative z-30 max-w-4xl pb-1 mx-auto mt-10 bg-white dark:bg-neutral-950 md:rounded-t-md text-neutral-900"
  >
    <div
      class="relative flex flex-col px-5 pt-6 border-t border-b-0 md:border-r md:border-l md:pt-20 lg:px-0 justify-stretch md:rounded-t-2xl border-neutral-200 dark:border-neutral-800"
    >
      <div
        class="absolute top-0 left-0 hidden w-px h-full mt-1 -translate-x-px md:block bg-gradient-to-b from-transparent to-white dark:to-neutral-950"
      >
      </div>
      <div
        class="absolute top-0 right-0 hidden w-px h-full mt-1 translate-x-px md:block bg-gradient-to-b from-transparent to-white dark:to-neutral-950"
      >
      </div>
      <div class="w-full max-w-2xl mx-auto">
        <h1
          class="text-[34px] font-bold text-left mb-4 md:mb-6 dark:text-neutral-100"
        >
          {frontmatter.title}
        </h1>
        <time
          class="block text-sm text-neutral-500 dark:text-neutral-400 mb-5"
        >
          {formatDisplayDate(frontmatter.date)}
        </time>
        <div
          id="tts-player"
          data-tts-id={audioId}
          data-tts-slug={audioSlug}
          class="mb-12 md:mb-16 border-t border-neutral-200 dark:border-neutral-800 pt-4"
        >
          <div class="flex items-center gap-2.5 sm:gap-4">
            <button
              id="tts-toggle"
              type="button"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-neutral-900 transition hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
              aria-label="聆听文章"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
              </svg>
            </button>
            <span
              id="tts-label"
              data-tts-idle
              class="shrink-0 text-base font-medium text-neutral-900 dark:text-neutral-100 sm:text-lg"
            >
              聆听文章
            </span>
            <span
              data-tts-idle
              class="h-6 w-px shrink-0 bg-neutral-200 dark:bg-neutral-700"
              aria-hidden="true"></span>
            <span
              id="tts-time"
              class="shrink-0 text-base font-medium tabular-nums text-neutral-900 dark:text-neutral-100 sm:text-lg"
            >
              0:00
            </span>
            <div
              id="tts-progress"
              data-tts-extra
              class="group relative hidden h-1.5 min-w-[80px] flex-1 cursor-pointer rounded-full bg-neutral-200 dark:bg-neutral-700"
              role="slider"
              aria-label="播放进度"
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <div
                id="tts-progress-fill"
                class="absolute inset-y-0 left-0 rounded-full bg-neutral-900 dark:bg-neutral-100"
                style="width: 0%"
              >
              </div>
              <div
                id="tts-progress-knob"
                class="absolute top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-neutral-900 opacity-0 transition-opacity group-hover:opacity-100 dark:bg-neutral-100"
                style="left: 0%"
              >
              </div>
            </div>
            <button
              id="tts-speed"
              data-tts-extra
              type="button"
              class="hidden shrink-0 rounded-full border border-neutral-300 px-3 py-1.5 text-sm font-medium tabular-nums text-neutral-900 transition hover:border-neutral-500 dark:border-neutral-600 dark:text-neutral-100 dark:hover:border-neutral-400"
              aria-label="播放速度"
            >
              1x
            </button>
            <button
              id="tts-share"
              type="button"
              class="ml-auto flex shrink-0 items-center gap-1.5 text-sm font-medium text-neutral-900 transition hover:text-neutral-500 dark:text-neutral-100 dark:hover:text-neutral-400"
              aria-label="分享本文"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5">
                <path d="M9.5 14.5 14.5 9.5"></path>
                <path d="M13 7.5l1.4-1.4a3.4 3.4 0 0 1 4.8 4.8L17.8 12.3"></path>
                <path d="M11 16.5l-1.4 1.4a3.4 3.4 0 0 1-4.8-4.8L6.2 11.7"></path>
              </svg>
              <span id="tts-share-label">分享</span>
            </button>
          </div>
          <p id="tts-status" class="mt-2 text-xs text-neutral-500 dark:text-neutral-400" hidden></p>
        </div>
      </div>
    </div>

    <article
      id="article-content"
      class="w-full max-w-2xl mx-auto mb-12 prose prose-sm px-5 lg:px-0 lg:prose-base dark:prose-invert"
    >
      <slot />
    </article>

    <div class="flex w-full max-w-2xl mx-auto px-5 lg:px-0 mb-10 not-prose justify-center">
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="本作品采用 CC BY 4.0 许可"
        class="inline-flex items-center gap-2 text-neutral-500 transition hover:text-neutral-800 dark:text-neutral-500 dark:hover:text-neutral-300"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <text x="12" y="15.4" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor">CC</text>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <circle cx="12" cy="8.6" r="2.3" fill="currentColor"></circle>
          <path d="M7.6 16.8c0-2.4 2-4.3 4.4-4.3s4.4 1.9 4.4 4.3Z" fill="currentColor"></path>
        </svg>
        <span class="text-sm font-medium tracking-wide">CC BY 4.0</span>
      </a>
    </div>

    <div class="w-full max-w-2xl mx-auto px-5 lg:px-0">
      <slot name="comments" />
    </div>

    <div class="w-full max-w-2xl mx-auto px-5 lg:px-0 mb-16">
      <slot name="nav" />
    </div>
  </main>

  <script is:inline>	const player = document.getElementById('tts-player');
	const toggleBtn = document.getElementById('tts-toggle');
	const timeEl = document.getElementById('tts-time');
	const progressEl = document.getElementById('tts-progress');
	const fillEl = document.getElementById('tts-progress-fill');
	const knobEl = document.getElementById('tts-progress-knob');
	const speedBtn = document.getElementById('tts-speed');
	const shareBtn = document.getElementById('tts-share');
	const shareLabel = document.getElementById('tts-share-label');
	const statusEl = document.getElementById('tts-status');
	const articleContent = document.getElementById('article-content');

	// token 只在 Pages 环境变量里，浏览器打同源代理，页面源码看不到它
	const TTS_ENDPOINT = '/api/tts';
	const AUDIO_SLUG = player?.dataset.ttsSlug || '';
	const AUDIO_ID = player?.dataset.ttsId || '';
	const SPEEDS = [1, 1.25, 1.5, 1.75, 2];
	// 合成前拿不到真实音频长度，按中文语速估算总时长
	const CHARS_PER_SEC = 4.3;

	if (player && toggleBtn && articleContent) {
		const playIcon = `
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
        </svg>`;
		const pauseIcon = `
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <rect x="7" y="5" width="3.6" height="14" rx="1.2"></rect>
          <rect x="13.4" y="5" width="3.6" height="14" rx="1.2"></rect>
        </svg>`;
		const spinnerIcon = `
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5 animate-spin">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
        </svg>`;

		// 正文之外的块（标签、评论区）都带 not-prose，不该被朗读；
		// 顺带剔除 script/style/link，避免把 Waline 等第三方脚本代码读出来
		const readableText = () =>
			Array.from(articleContent.children)
				.filter(
					(el) =>
						!el.classList.contains('not-prose') &&
						!el.querySelector('#waline') &&
						el.id !== 'waline',
				)
				.map((el) => {
					const clone = el.cloneNode(true);
					clone.querySelectorAll('script, style, link').forEach((n) => n.remove());
					return clone.innerText || clone.textContent || '';
				})
				.join('\n')
				.replace(/\s+/g, ' ')
				.trim();

		let audio = null;
		let playing = false;
		let loading = false;
		let started = false;
		let abortController = null;
		let speedIndex = 0;
		let estimated = 0;

		const formatTime = (seconds) => {
			const total = Math.max(0, Math.floor(seconds || 0));
			return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
		};

		// 总时长：优先取真实音频 duration，取不到（未加载完）用估算
		const totalTime = () =>
			audio && Number.isFinite(audio.duration) && audio.duration > 0 ? audio.duration : estimated;
		const renderTime = () => {
			timeEl.textContent =
				started || loading
					? `${formatTime(audio ? audio.currentTime : 0)} / ${formatTime(totalTime())}`
					: formatTime(estimated);
		};
		const renderProgress = () => {
			if (!progressEl) return;
			const dur = totalTime();
			const frac = dur > 0 ? Math.min(1, (audio ? audio.currentTime : 0) / dur) : 0;
			const pct = `${(frac * 100).toFixed(2)}%`;
			if (fillEl) fillEl.style.width = pct;
			if (knobEl) knobEl.style.left = pct;
		};

		const setStatus = (text) => {
			if (!statusEl) return;
			statusEl.textContent = text || '';
			statusEl.hidden = !text;
		};

		// 未开播时显示"聆听文章 | 估算总时长"，开播后换成进度和快进控件
		const idleEls = player.querySelectorAll('[data-tts-idle]');
		const extras = player.querySelectorAll('[data-tts-extra]');
		const updateUI = () => {
			const idle = !loading && !started;
			for (const el of idleEls) el.classList.toggle('hidden', !idle);
			for (const el of extras) el.classList.toggle('hidden', idle);
			renderTime();
			toggleBtn.innerHTML = loading ? spinnerIcon : playing ? pauseIcon : playIcon;
			const label = loading ? '加载中' : playing ? '暂停' : started ? '继续播放' : '聆听文章';
			toggleBtn.setAttribute('aria-label', label);
			toggleBtn.setAttribute('aria-pressed', String(playing));
		};

		const detachAudio = () => {
			if (!audio) return;
			audio.pause();
			if (audio.dataset.url) URL.revokeObjectURL(audio.dataset.url);
			audio = null;
		};

		// 把一段完整音频（presigned 链接或 blob）挂到 <audio> 上播放
		const playUrl = (audioUrl) => {
			detachAudio();
			loading = false;
			setStatus('');
			const el = new Audio(audioUrl);
			el.dataset.url = audioUrl;
			el.playbackRate = SPEEDS[speedIndex];
			audio = el;
			el.addEventListener('loadedmetadata', () => {
				renderTime();
				renderProgress();
			});
			el.addEventListener('timeupdate', () => {
				renderTime();
				renderProgress();
			});
			// play/pause 事件驱动按钮图标切换（el.play() 是异步的，promise 后必须刷新 UI）
			el.addEventListener('play', () => {
				playing = true;
				updateUI();
			});
			el.addEventListener('pause', () => {
				playing = false;
				updateUI();
			});
			el.addEventListener('ended', () => {
				playing = false;
				started = false;
				updateUI();
			});
			el.addEventListener('error', () => {
				if (!started) {
					loading = false;
					setStatus('语音加载失败，请稍后重试');
				}
				updateUI();
			});
			el.play()
				.then(() => {
					started = true;
					updateUI();
				})
				.catch(() => {
					playing = false;
					updateUI();
				});
			updateUI();
		};

		const start = () => {
			const text = readableText();
			if (!text) return;
			abortController = new AbortController();
			loading = true;
			started = false;
			playing = false;
			updateUI();
			setStatus('正在合成语音…');
			fetch(TTS_ENDPOINT, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ slug: AUDIO_SLUG, id: AUDIO_ID, text }),
				signal: abortController.signal,
			})
				.then(async (res) => {
					if (!res.ok) throw new Error('TTS request failed');
					// 命中缓存时返回 JSON { audio_url }；兜底时直接返回 MP3 流
					if ((res.headers.get('content-type') || '').includes('audio')) {
						playUrl(URL.createObjectURL(await res.blob()));
					} else {
						const j = await res.json();
						if (!j.audio_url) throw new Error('No audio_url');
						playUrl(j.audio_url);
					}
				})
				.catch(() => {
					if (abortController && abortController.signal.aborted) return;
					loading = false;
					playing = false;
					started = false;
					updateUI();
					setStatus('语音合成失败，请稍后重试');
				});
		};

		const handleToggle = () => {
			if (loading) return;
			if (!started) {
				start();
				return;
			}
			if (!audio) return;
			if (playing) {
				audio.pause();
				playing = false;
			} else {
				audio.play();
				playing = true;
			}
			updateUI();
		};

		// 进度条：点击 / 拖动跳转
		let dragging = false;
		const seekTo = (clientX) => {
			if (!audio || loading || !progressEl) return;
			const rect = progressEl.getBoundingClientRect();
			if (!rect.width) return;
			const frac = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
			const dur = totalTime();
			audio.currentTime = frac * dur;
			renderTime();
			renderProgress();
		};

		const cycleSpeed = () => {
			speedIndex = (speedIndex + 1) % SPEEDS.length;
			const rate = SPEEDS[speedIndex];
			if (audio) audio.playbackRate = rate;
			speedBtn.textContent = `${rate}x`;
		};

		let shareTimer;
		const flashShare = (text) => {
			if (!shareLabel) return;
			shareLabel.textContent = text;
			clearTimeout(shareTimer);
			shareTimer = setTimeout(() => {
				shareLabel.textContent = '分享';
			}, 2000);
		};

		const handleShare = async () => {
			const url = location.href;
			if (navigator.share) {
				try {
					await navigator.share({ title: document.title, url });
				} catch {
					/* 用户取消分享 */
				}
				return;
			}
			try {
				await navigator.clipboard.writeText(url);
				flashShare('已复制链接');
			} catch {
				flashShare('复制失败');
			}
		};

		const stopAll = () => {
			if (abortController) abortController.abort();
			detachAudio();
			playing = false;
		};

		toggleBtn.addEventListener('click', handleToggle);
		if (progressEl) {
			progressEl.addEventListener('pointerdown', (e) => {
				dragging = true;
				progressEl.setPointerCapture(e.pointerId);
				seekTo(e.clientX);
			});
			progressEl.addEventListener('pointermove', (e) => {
				if (dragging) seekTo(e.clientX);
			});
			progressEl.addEventListener('pointerup', () => {
				dragging = false;
			});
			progressEl.addEventListener('pointercancel', () => {
				dragging = false;
			});
		}
		speedBtn?.addEventListener('click', cycleSpeed);
		shareBtn?.addEventListener('click', handleShare);
		window.addEventListener('beforeunload', stopAll);

		const initialText = readableText();
		if (initialText) estimated = initialText.length / CHARS_PER_SEC;
		else player.hidden = true;
		updateUI();
	} else if (player) {
		player.hidden = true;
	}
</script>
</Layout>
