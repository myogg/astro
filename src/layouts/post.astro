---
import Layout from "./main.astro";
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main
    class="relative z-30 max-w-4xl pb-1 mx-auto mt-10 bg-white dark:bg-neutral-950 md:rounded-t-md text-neutral-900"
  >
    <div
      class="relative flex flex-col px-5 pt-6 border-t border-b-0 md:border-r md:border-l md:pt-20 lg:px-0 justify-stretch md:rounded-t-2xl border-neutral-200 dark:border-neutral-800"
    >
      <div
        class="absolute top-0 left-0 hidden w-px h-full mt-1 -translate-x-px md:block bg-gradient-to-b from-transparent to-white dark:to-neutral-950"
      >
      </div>
      <div
        class="absolute top-0 right-0 hidden w-px h-full mt-1 translate-x-px md:block bg-gradient-to-b from-transparent to-white dark:to-neutral-950"
      >
      </div>
      <div class="w-full max-w-2xl mx-auto">
        <h1
          class="text-3xl font-bold leading-tight tracking-tighter text-left mb-4 md:mb-6 md:text-4xl dark:text-neutral-100 lg:text-5xl md:leading-none"
        >
          {frontmatter.title}
        </h1>
        <time
          class="block text-sm text-neutral-500 dark:text-neutral-400 mb-5"
        >
          {frontmatter.dateFormatted}
        </time>
        <div
          id="tts-player"
          class="mb-12 md:mb-16 border-t border-neutral-200 dark:border-neutral-800 pt-4"
        >
          <div class="flex items-center gap-2.5 sm:gap-4">
            <button
              id="tts-toggle"
              type="button"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-neutral-900 transition hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
              aria-label="听全文"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
              </svg>
            </button>
            <span
              id="tts-time"
              data-tts-extra
              class="hidden text-base font-medium tabular-nums text-neutral-900 dark:text-neutral-100 sm:text-lg"
            >
              0:00
            </span>
            <span
              data-tts-extra
              class="hidden h-6 w-px shrink-0 bg-neutral-200 dark:bg-neutral-700"
              aria-hidden="true"></span>
            <button
              id="tts-back"
              data-tts-extra
              type="button"
              class="hidden shrink-0 text-neutral-900 transition hover:text-neutral-500 dark:text-neutral-100 dark:hover:text-neutral-400"
              aria-label="后退 15 秒"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6">
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4a8 8 0 1 0 8 8"></path>
                  <path d="M12 4l3.2-2.4M12 4l3.2 2.4"></path>
                </g>
                <text x="12" y="16.5" text-anchor="middle" font-size="8.5" font-weight="700" fill="currentColor">15</text>
              </svg>
            </button>
            <button
              id="tts-forward"
              data-tts-extra
              type="button"
              class="hidden shrink-0 text-neutral-900 transition hover:text-neutral-500 dark:text-neutral-100 dark:hover:text-neutral-400"
              aria-label="前进 15 秒"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6">
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4a8 8 0 1 1-8 8"></path>
                  <path d="M12 4l-3.2-2.4M12 4l-3.2 2.4"></path>
                </g>
                <text x="12" y="16.5" text-anchor="middle" font-size="8.5" font-weight="700" fill="currentColor">15</text>
              </svg>
            </button>
            <button
              id="tts-speed"
              data-tts-extra
              type="button"
              class="hidden shrink-0 rounded-full border border-neutral-300 px-3 py-1.5 text-sm font-medium tabular-nums text-neutral-900 transition hover:border-neutral-500 dark:border-neutral-600 dark:text-neutral-100 dark:hover:border-neutral-400"
              aria-label="播放速度"
            >
              1x
            </button>
            <button
              id="tts-share"
              data-tts-extra
              type="button"
              class="hidden ml-auto flex shrink-0 items-center gap-1.5 text-sm font-medium text-neutral-900 transition hover:text-neutral-500 dark:text-neutral-100 dark:hover:text-neutral-400"
              aria-label="分享本文"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5">
                <path d="M9.5 14.5 14.5 9.5"></path>
                <path d="M13 7.5l1.4-1.4a3.4 3.4 0 0 1 4.8 4.8L17.8 12.3"></path>
                <path d="M11 16.5l-1.4 1.4a3.4 3.4 0 0 1-4.8-4.8L6.2 11.7"></path>
              </svg>
              <span id="tts-share-label">分享</span>
            </button>
          </div>
          <p id="tts-status" class="mt-2 text-xs text-neutral-500 dark:text-neutral-400" hidden></p>
        </div>
      </div>
    </div>

    <article
      id="article-content"
      class="w-full max-w-2xl mx-auto mb-12 prose-base prose px-5 lg:px-0 lg:prose-lg dark:prose-invert"
    >
      <slot />
    </article>

    <div class="w-full max-w-2xl mx-auto px-5 lg:px-0 mb-16">
      <slot name="nav" />
    </div>
  </main>

  <script is:inline>
    const player = document.getElementById('tts-player');
    const toggleBtn = document.getElementById('tts-toggle');
    const timeEl = document.getElementById('tts-time');
    const backBtn = document.getElementById('tts-back');
    const forwardBtn = document.getElementById('tts-forward');
    const speedBtn = document.getElementById('tts-speed');
    const shareBtn = document.getElementById('tts-share');
    const shareLabel = document.getElementById('tts-share-label');
    const statusEl = document.getElementById('tts-status');
    const articleContent = document.getElementById('article-content');

    const TTS_API = 'https://tts.134688.xyz';
    const TTS_TOKEN = 'tts100412';
    const SPEEDS = [1, 1.25, 1.5, 1.75, 2];
    const SKIP = 15;

    if (player && toggleBtn && articleContent) {
      const playIcon = `
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
        </svg>`;
      const pauseIcon = `
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <rect x="7" y="5" width="3.6" height="14" rx="1.2"></rect>
          <rect x="13.4" y="5" width="3.6" height="14" rx="1.2"></rect>
        </svg>`;
      const spinnerIcon = `
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5 animate-spin">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
        </svg>`;

      // 正文之外的块（标签、评论区）都带 not-prose，不该被朗读
      const readableText = () =>
        Array.from(articleContent.children)
          .filter((el) => !el.classList.contains('not-prose'))
          .map((el) => el.innerText || el.textContent || '')
          .join('\n')
          .replace(/\s+/g, ' ')
          .trim();

      let chunks = [];
      const blobs = new Map();
      const durations = [];
      let index = 0;
      let audio = null;
      let playing = false;
      let loading = false;
      let started = false;
      let abortController = null;
      let speedIndex = 0;

      const formatTime = (seconds) => {
        const total = Math.max(0, Math.floor(seconds || 0));
        return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
      };

      const offsetOf = (i) => {
        let sum = 0;
        for (let k = 0; k < i; k++) sum += durations[k] || 0;
        return sum;
      };

      const renderTime = () => {
        timeEl.textContent = formatTime(offsetOf(index) + (audio ? audio.currentTime : 0));
      };

      const setStatus = (text) => {
        if (!statusEl) return;
        statusEl.textContent = text || '';
        statusEl.hidden = !text;
      };

      // 未开始播放时只露出播放按钮，其余控件在开播后出现
      const extras = player.querySelectorAll('[data-tts-extra]');
      const updateUI = () => {
        for (const el of extras) el.classList.toggle('hidden', !loading && !started);
        toggleBtn.innerHTML = loading ? spinnerIcon : playing ? pauseIcon : playIcon;
        const label = loading ? '加载中' : playing ? '暂停' : started ? '继续播放' : '听全文';
        toggleBtn.setAttribute('aria-label', label);
        toggleBtn.setAttribute('aria-pressed', String(playing));
      };

      function splitText(text, maxLen) {
        const parts = [];
        let rest = text;
        while (rest.length > maxLen) {
          let cut = maxLen;
          const chunk = rest.slice(0, maxLen);
          const stop = Math.max(
            chunk.lastIndexOf('。'),
            chunk.lastIndexOf('！'),
            chunk.lastIndexOf('？'),
            chunk.lastIndexOf('\n'),
          );
          if (stop > maxLen * 0.4) cut = stop + 1;
          parts.push(rest.slice(0, cut).trim());
          rest = rest.slice(cut).trim();
        }
        if (rest.trim()) parts.push(rest.trim());
        return parts;
      }

      async function getBlob(i) {
        if (blobs.has(i)) return blobs.get(i);
        const params = new URLSearchParams({
          text: chunks[i],
          voiceName: 'zh-CN-XiaoxiaoNeural',
          token: TTS_TOKEN,
        });
        const res = await fetch(`${TTS_API}/api/synthesis?${params}`, {
          signal: abortController.signal,
        });
        if (!res.ok) throw new Error('TTS API error');
        const blob = await res.blob();
        blobs.set(i, blob);
        return blob;
      }

      const prefetch = (i) => {
        if (i < 0 || i >= chunks.length || blobs.has(i)) return;
        getBlob(i).catch(() => {});
      };

      const detachAudio = () => {
        if (!audio) return;
        audio.pause();
        if (audio.dataset.url) URL.revokeObjectURL(audio.dataset.url);
        audio = null;
      };

      async function playFrom(i, seek = 0) {
        if (i >= chunks.length) {
          detachAudio();
          playing = false;
          started = false;
          index = 0;
          renderTime();
          updateUI();
          return;
        }

        const target = Math.max(0, i);
        detachAudio();
        index = target;
        loading = true;
        updateUI();
        setStatus(`正在合成第 ${target + 1}/${chunks.length} 段`);

        let blob;
        try {
          blob = await getBlob(target);
        } catch {
          if (abortController && abortController.signal.aborted) return;
          loading = false;
          playing = false;
          updateUI();
          setStatus('语音合成失败，请稍后重试');
          return;
        }

        loading = false;
        setStatus('');

        const url = URL.createObjectURL(blob);
        const el = new Audio(url);
        el.dataset.url = url;
        el.playbackRate = SPEEDS[speedIndex];
        audio = el;

        el.addEventListener('loadedmetadata', () => {
          if (Number.isFinite(el.duration)) durations[target] = el.duration;
          if (seek > 0) el.currentTime = Math.min(seek, el.duration || seek);
          renderTime();
        });
        el.addEventListener('timeupdate', renderTime);
        el.addEventListener('ended', () => playFrom(target + 1));
        el.addEventListener('error', () => playFrom(target + 1));

        try {
          await el.play();
          playing = true;
          started = true;
        } catch {
          playing = false;
        }
        updateUI();
        prefetch(target + 1);
      }

      const start = () => {
        chunks = splitText(readableText(), 300);
        if (!chunks.length) return;
        abortController = new AbortController();
        durations.length = 0;
        playFrom(0);
      };

      const handleToggle = () => {
        if (loading) return;
        if (!started) {
          start();
          return;
        }
        if (!audio) return;
        if (playing) {
          audio.pause();
          playing = false;
        } else {
          audio.play();
          playing = true;
        }
        updateUI();
      };

      const skip = (delta) => {
        if (!started || !audio || loading) return;
        const next = audio.currentTime + delta;
        if (next < 0) {
          if (index === 0) {
            audio.currentTime = 0;
            renderTime();
          } else {
            playFrom(index - 1, Math.max(0, (durations[index - 1] || 0) + next));
          }
          return;
        }
        const duration = Number.isFinite(audio.duration) ? audio.duration : null;
        if (duration !== null && next > duration) {
          if (index + 1 < chunks.length) playFrom(index + 1, next - duration);
          else {
            audio.currentTime = duration;
            renderTime();
          }
          return;
        }
        audio.currentTime = next;
        renderTime();
      };

      const cycleSpeed = () => {
        speedIndex = (speedIndex + 1) % SPEEDS.length;
        const rate = SPEEDS[speedIndex];
        if (audio) audio.playbackRate = rate;
        speedBtn.textContent = `${rate}x`;
      };

      let shareTimer;
      const flashShare = (text) => {
        if (!shareLabel) return;
        shareLabel.textContent = text;
        clearTimeout(shareTimer);
        shareTimer = setTimeout(() => {
          shareLabel.textContent = '分享';
        }, 2000);
      };

      const handleShare = async () => {
        const url = location.href;
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url });
          } catch {
            /* 用户取消分享 */
          }
          return;
        }
        try {
          await navigator.clipboard.writeText(url);
          flashShare('已复制链接');
        } catch {
          flashShare('复制失败');
        }
      };

      const stopAll = () => {
        if (abortController) abortController.abort();
        detachAudio();
        playing = false;
      };

      toggleBtn.addEventListener('click', handleToggle);
      backBtn?.addEventListener('click', () => skip(-SKIP));
      forwardBtn?.addEventListener('click', () => skip(SKIP));
      speedBtn?.addEventListener('click', cycleSpeed);
      shareBtn?.addEventListener('click', handleShare);
      window.addEventListener('beforeunload', stopAll);

      if (!readableText()) player.hidden = true;
      updateUI();
    } else if (player) {
      player.hidden = true;
    }
  </script>
</Layout>
