---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
const SITE_NAME = "灰太狼 - 做一个有意思的人";
const {
  title,
  description = SITE_NAME,
  noindex = false,
  fullTitle,
  image = "/images/og-default.jpg",
} = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${SITE_NAME}`;
const ogImageUrl = new URL(image, Astro.site ?? "https://134688.xyz").href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Used to add dark mode right away, adding here prevents any flicker -->
    <script is:inline>
      if (typeof Storage !== 'undefined') {
        if (
          localStorage.getItem('dark_mode') &&
          localStorage.getItem('dark_mode') == 'true'
        ) {
          document.documentElement.classList.add('dark')
        }
      }
    </script>

    <!-- 全站统一小米 MiSans（WOFF2 子集，jsDelivr 加载，免费可商用） -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/misans@5.0.0/lib/Normal/MiSans-Regular.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/misans@5.0.0/lib/Normal/MiSans-Medium.min.css"
    />

    <style>
      .prose img {
        border-radius: 12px;
      }

      /* 借鉴 phpBB 的克制配色：清晰链接、轻分隔，不改变现有布局 */
      .prose a {
        color: #2563a6;
        text-decoration-color: #b8c9dc;
        text-underline-offset: 0.18em;
        transition: color 160ms ease;
      }

      .prose a:hover {
        color: #174675;
        text-decoration-color: currentColor;
      }

      .dark .prose a {
        color: #8ab4e0;
        text-decoration-color: #42566b;
      }

      .dark .prose a:hover {
        color: #b6d5f4;
      }

      .prose hr {
        border-color: #e5e7eb;
      }

      .dark .prose hr {
        border-color: #30343a;
      }

      /* 全站统一 MiSans：正文 Regular 400，标题 Medium 500 */
      .prose.prose {
        font-family: "MiSans", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        font-weight: 400;
        font-size: 18px;
        line-height: 1.9;
        color: #333333;
        hanging-punctuation: first allow-end last;
        max-width: 65ch;
      }

      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 {
        font-family: "MiSans", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        font-weight: 500;
      }

      /* 文章标题 26-30px / 小标题 20-22px */
      .prose h1,
      .prose h2 { font-size: 28px; line-height: 1.3; }
      .prose h2 { margin-top: 2em; }
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 { font-size: 21px; line-height: 1.5; }
      .prose h3 { margin-top: 1.6em; }

      /* 首字下沉 — 首字母用衬线体，中文首字也生效 */
      .prose > p:first-of-type::first-letter {
        float: left;
        font-size: 3.2em;
        line-height: 0.9;
        padding-right: 0.06em;
        margin-top: 0.04em;
        font-weight: 500;
        font-family: "MiSans", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        color: #333333;
      }

      .prose > p:first-of-type {
        clear: both;
      }

      /* 中文段落间距优化 */
      .prose p {
        margin-bottom: 2em;
        line-height: 1.9;
      }

      /* 引用块样式 */
      .prose blockquote {
        border-left-color: #a1a1aa;
        font-style: normal;
      }

      /* 手机端：正文略小 */
      @media (max-width: 640px) {
        .prose {
          font-size: 17px;
          line-height: 1.88;
        }
      }

    </style>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script src="../assets/css/main.css"></script>
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="antialiased bg-[#FAF9F6] dark:bg-neutral-950">
    <SquareLines />
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
    <!-- 外链处理：新窗口 + nofollow -->
    <script is:inline>
      document.querySelectorAll('.prose a[href^="http"]').forEach(a => {
        if (!a.target) a.target = '_blank';
        a.rel = 'nofollow noopener noreferrer';
      });
    </script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
