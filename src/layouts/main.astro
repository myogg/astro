---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
const SITE_NAME = "灰太狼 - 做一个有意思的人";
const {
  title,
  description = SITE_NAME,
  noindex = false,
  fullTitle,
  image = "/images/og-default.jpg",
} = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${SITE_NAME}`;
const ogImageUrl = new URL(image, Astro.site ?? "https://134688.xyz").href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Used to add dark mode right away, adding here prevents any flicker -->
    <script is:inline>
      if (typeof Storage !== 'undefined') {
        if (
          localStorage.getItem('dark_mode') &&
          localStorage.getItem('dark_mode') == 'true'
        ) {
          document.documentElement.classList.add('dark')
        }
      }
    </script>

    <style is:global>
      .prose img {
        border-radius: 20px;
      }

      /* 全站字体：Tailwind 默认系统字体栈（与 aria / miantiao.me 官方一致，无自定义字体） */
      .prose.prose {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial, sans-serif;
        font-weight: 400;
        font-size: 18px;
        line-height: 1.9;
        color: #333333;
        hanging-punctuation: first allow-end last;
        max-width: 65ch;
      }

      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial, sans-serif;
        font-weight: 500;
      }

      /* 文章标题 28px，默认行高；小标题 21px */
      .prose h1,
      .prose h2 { font-size: 28px; }
      .prose h2 { margin-top: 2em; }
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 { font-size: 21px; line-height: 1.5; }
      .prose h3 { margin-top: 1.6em; }

      /* 中文段落间距优化 */
      .prose p {
        margin-bottom: 2em;
        line-height: 1.9;
      }

      /* 引用块样式 */
      .prose blockquote {
        border-left-color: #a1a1aa;
        font-style: normal;
      }

      /* 手机端：正文 19px（比 20px 小一号） */
      @media (max-width: 640px) {
        .prose.prose {
          font-size: 19px;
          line-height: 1.9;
        }
      }

    </style>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script src="../assets/css/main.css"></script>
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="antialiased font-sans bg-white dark:bg-neutral-950">
    <SquareLines />
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
    <!-- 外链处理：新窗口 + nofollow -->
    <script is:inline>
      document.querySelectorAll('.prose a[href^="http"]').forEach(a => {
        if (!a.target) a.target = '_blank';
        a.rel = 'nofollow noopener noreferrer';
      });
    </script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
