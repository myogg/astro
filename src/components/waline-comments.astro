---
---

<div id="waline" class="not-prose mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800"></div>

<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />

<script is:inline type="module">
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";

  const mountWaline = () => {
    const container = document.querySelector("#waline");
    if (!container || container.dataset.walineInitialized === "true") return;

    container.dataset.walineInitialized = "true";
    const placeholder = "👏 欢迎来踩";
    const applyPlaceholder = () => {
      const editor = container.querySelector("textarea");
      if (editor && editor.placeholder !== placeholder) {
        editor.placeholder = placeholder;
      }
    };

    // Keep the custom text even if Waline renders or replaces the editor asynchronously.
    const observer = new MutationObserver(applyPlaceholder);
    observer.observe(container, { childList: true, subtree: true });

    init({
      el: container,
      serverURL: "https://commsin-134688.vercel.app",
      path: window.location.pathname,
      lang: "zh-CN",
      login: "disable",
      meta: ["nick"],
      requiredMeta: ["nick"],
      dark: "html.dark",
      imageUploader: false,
      noCopyright: true,
      noRss: true,
      placeholder,
    });

    applyPlaceholder();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mountWaline, { once: true });
  } else {
    mountWaline();
  }
</script>
