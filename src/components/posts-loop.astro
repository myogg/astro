---
import { getCollection } from "astro:content";
import PostsList from "./posts-list.astro";
import { byDateDesc } from "../utils/date";

const allPosts = await getCollection("post", ({ data }) => !data.draft);
const { count } = Astro.props;

const posts = allPosts.sort(byDateDesc).slice(0, count);
---

<PostsList posts={posts} showMoreTag={false} />
